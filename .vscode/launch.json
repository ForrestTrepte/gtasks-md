{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Equivalent to `uv run gtasks-md view`, under the debugger.
            "name": "gtasks-md (uv)",
            "type": "debugpy",
            "request": "launch",
            "module": "app",
            "python": "/opt/venvs/python-docker-devcontainers/bin/python",
            "preLaunchTask": "uv sync",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "view"
            ]
        }
    ]
}

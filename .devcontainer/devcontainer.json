{
    "name": "gtasks-md",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "anthropic.claude-code"
            ]
        }
    },
    "forwardPorts": [
        4444
    ],
    "mounts": [
        "source=claude-config,target=/root/.claude,type=volume",
        "source=${localEnv:USERPROFILE}\\OneDrive\\Development\\Crd\\260723_Desktop_OAuth_client_ID.json,target=/root/.local/share/gtasks-md/default/credentials.json,type=bind,readonly"
    ]
}